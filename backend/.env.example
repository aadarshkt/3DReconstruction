# Backend environment variables — copy to .env and fill in secrets
# Never commit the real .env to version control

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=floorplan
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=floorplan

DATABASE_URL=postgresql+asyncpg://floorplan:change_me_in_prod@localhost:5432/floorplan
DATABASE_SYNC_URL=postgresql+psycopg2://floorplan:change_me_in_prod@localhost:5432/floorplan

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
DATA_DIR=data

# ── COLMAP ────────────────────────────────────────────────────────────────────
# On Mac with COLMAP via Homebrew: /opt/homebrew/bin/colmap
# On Linux: colmap
COLMAP_BIN=colmap
