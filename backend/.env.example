# Backend environment variables — copy to .env and fill in secrets
# Never commit the real .env to version control

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=floorplan
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=floorplan

DATABASE_URL=postgresql+asyncpg://floorplan:change_me_in_prod@localhost:5432/floorplan
DATABASE_SYNC_URL=postgresql+psycopg2://floorplan:change_me_in_prod@localhost:5432/floorplan

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
DATA_DIR=data

# ── COLMAP ────────────────────────────────────────────────────────────────────
# On Mac with COLMAP via Homebrew: /opt/homebrew/bin/colmap
# On Linux: colmap
COLMAP_BIN=colmap

# ── LLM / Agent ───────────────────────────────────────────────────────────────
# OpenAI-compatible chat completions endpoint. Leave API key empty unless
# the insurance claim agent's damage-assessment feature is being used.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096
